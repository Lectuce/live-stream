# Add inside the existing public server block, alongside /api and frontend proxy.
# Do not expose ports 1985 or 9001, or add a public /hooks proxy.
location /live-media/ {
    proxy_pass http://127.0.0.1:8080/live/;
    proxy_buffering off;
    proxy_cache off;
    add_header Cache-Control "no-store" always;
}

# SRS emits absolute /live URLs in its master playlist. Match only media files
# so the frontend /live/ page continues to reach the application on port 3100.
location ~ ^/live/[A-Za-z0-9-]+\.(m3u8|ts)$ {
    proxy_pass http://127.0.0.1:8080;
    proxy_buffering off;
    proxy_cache off;
    add_header Cache-Control "no-store" always;
}
